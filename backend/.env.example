# StudyFlow AI backend configuration
# Copy to .env and fill in values. Never commit your real .env.

# --- LLM (optional) ---
# When these are set, the agents use a real OpenAI-compatible model.
# When OPENAI_API_KEY is empty, the app runs in a clearly-labeled deterministic
# demo mode (no external calls).
OPENAI_API_KEY=
# Base URL for OpenAI-compatible APIs (OpenAI, Azure, local servers, etc.)
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=30

# --- App ---
DATABASE_URL=sqlite:///./studyflow.db
# Comma-separated list of allowed CORS origins for the frontend dev server.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Default timezone for the demo student (IANA name).
DEFAULT_TIMEZONE=America/New_York
# Set to true to populate a fresh database with realistic sample academic data.
# Default false: the app starts empty (only the demo student profile exists).
SEED_SAMPLE_DATA=false
